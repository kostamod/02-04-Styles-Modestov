<Window x:Class="SecurityApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource PanelWindow}" Title="Панель защиты" Width="590" Height="600"
 MinWidth="480" MinHeight="460" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <DockPanel LastChildFill="False">
                <TextBlock Style="{StaticResource TitleText}" Text="Панель защиты"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Сменить тему" Click="Theme_Click"/>
            </DockPanel>
            <TextBlock Margin="0,14,0,3" Text="Устройство"/>
            <TextBox Text="Учебный ПК"/>
            <TextBlock Margin="0,10,0,3" Text="Заметка"/>
            <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="62" VerticalScrollBarVisibility="Auto"/>
            <CheckBox x:Name="Protection" Margin="0,14,0,6" Content="Защита включена" IsChecked="True"/>
            <CheckBox Margin="0,0,0,6" Content="Уведомления" IsChecked="True"/>
            <TextBlock Margin="0,8,0,4" Text="Режим проверки"/>
            <WrapPanel>
                <RadioButton x:Name="Quick" GroupName="Mode" Content="Быстрая" IsChecked="True"/>
                <RadioButton Margin="16,0,0,0" GroupName="Mode" Content="Полная"/>
            </WrapPanel>
            <TextBlock Margin="0,10,0,3" Text="Объект проверки"/>
            <ComboBox x:Name="Target" SelectedIndex="0">
                <ComboBoxItem Content="Учебное устройство"/>
                <ComboBoxItem Content="Папка с документами"/>
                <ComboBoxItem Content="Съёмный диск"/>
            </ComboBox>
            <TextBlock Margin="0,12,0,4" Text="Ход проверки"/>
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="Status" Margin="0,5" Text="Готово к запуску" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,8">
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Проверить"
                    IsEnabled="{Binding IsChecked, ElementName=Protection}" Click="Start_Click"/>
                <Button x:Name="StopButton" Margin="8,0" Style="{StaticResource ActionButton}" Content="Остановить"
                    IsEnabled="False" Click="Stop_Click"/>
                <Button Style="{StaticResource DangerButton}" Content="Отключить защиту"
                    IsEnabled="{Binding IsChecked, ElementName=Protection}" Click="Disable_Click"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
